/*=============================================================================
	NormalComputeShader.usf: Compute shaders for GPU-accelerated normal calculation
=============================================================================*/

#include "/Engine/Public/Platform.ush"

// Thread group size
#define THREADGROUP_SIZE_X 8
#define THREADGROUP_SIZE_Y 8
#define THREADGROUP_SIZE_Z 1

// Normal calculation methods
#define METHOD_SOBEL 0
#define METHOD_CENTRAL_DIFFERENCE 1
#define METHOD_SOBEL_SCHARR 2

//=============================================================================
// Normal Calculation
//=============================================================================

Texture2D<float> HeightmapInput;
RWTexture2D<float4> NormalOutput;

float HeightScale;
float HorizontalScale;
int CalculationMethod;
int EnableSmoothing;
int SmoothKernelSize;
float2 TextureSize;

// Safe texture sampling with border handling
float SampleHeight(int2 pos)
{
	int2 clampedPos = clamp(pos, int2(0, 0), int2(TextureSize) - int2(1, 1));
	return HeightmapInput[clampedPos];
}

// Sobel operator for normal calculation
float3 CalculateNormalSobel(int2 pos)
{
	// Sobel kernels
	// Gx:  -1  0  +1     Gy:  -1  -2  -1
	//      -2  0  +2           0   0   0
	//      -1  0  +1          +1  +2  +1

	float tl = SampleHeight(pos + int2(-1, -1));
	float t  = SampleHeight(pos + int2( 0, -1));
	float tr = SampleHeight(pos + int2( 1, -1));
	float l  = SampleHeight(pos + int2(-1,  0));
	float r  = SampleHeight(pos + int2( 1,  0));
	float bl = SampleHeight(pos + int2(-1,  1));
	float b  = SampleHeight(pos + int2( 0,  1));
	float br = SampleHeight(pos + int2( 1,  1));

	// Calculate gradients
	float dx = (tr + 2.0 * r + br) - (tl + 2.0 * l + bl);
	float dy = (bl + 2.0 * b + br) - (tl + 2.0 * t + tr);

	// Scale by height and horizontal scale
	dx *= HeightScale / (8.0 * HorizontalScale);
	dy *= HeightScale / (8.0 * HorizontalScale);

	// Calculate normal
	float3 normal = float3(-dx, -dy, 1.0);
	return normalize(normal);
}

// Sobel-Scharr operator (enhanced Sobel)
float3 CalculateNormalSobelScharr(int2 pos)
{
	// Scharr kernels (better rotation invariance)
	// Gx:  -3   0  +3     Gy:  -3  -10  -3
	//     -10   0 +10           0    0   0
	//      -3   0  +3          +3  +10  +3

	float tl = SampleHeight(pos + int2(-1, -1));
	float t  = SampleHeight(pos + int2( 0, -1));
	float tr = SampleHeight(pos + int2( 1, -1));
	float l  = SampleHeight(pos + int2(-1,  0));
	float r  = SampleHeight(pos + int2( 1,  0));
	float bl = SampleHeight(pos + int2(-1,  1));
	float b  = SampleHeight(pos + int2( 0,  1));
	float br = SampleHeight(pos + int2( 1,  1));

	float dx = (3.0 * tr + 10.0 * r + 3.0 * br) - (3.0 * tl + 10.0 * l + 3.0 * bl);
	float dy = (3.0 * bl + 10.0 * b + 3.0 * br) - (3.0 * tl + 10.0 * t + 3.0 * tr);

	dx *= HeightScale / (32.0 * HorizontalScale);
	dy *= HeightScale / (32.0 * HorizontalScale);

	float3 normal = float3(-dx, -dy, 1.0);
	return normalize(normal);
}

// Central difference method
float3 CalculateNormalCentralDifference(int2 pos)
{
	float l = SampleHeight(pos + int2(-1,  0));
	float r = SampleHeight(pos + int2( 1,  0));
	float t = SampleHeight(pos + int2( 0, -1));
	float b = SampleHeight(pos + int2( 0,  1));

	float dx = (r - l) * HeightScale / (2.0 * HorizontalScale);
	float dy = (b - t) * HeightScale / (2.0 * HorizontalScale);

	float3 normal = float3(-dx, -dy, 1.0);
	return normalize(normal);
}

[numthreads(THREADGROUP_SIZE_X, THREADGROUP_SIZE_Y, THREADGROUP_SIZE_Z)]
void CalculateNormalsCS(
	uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint width, height;
	NormalOutput.GetDimensions(width, height);

	if (DispatchThreadId.x >= width || DispatchThreadId.y >= height)
	{
		return;
	}

	int2 pos = int2(DispatchThreadId.xy);
	float3 normal;

	// Calculate normal based on method
	if (CalculationMethod == METHOD_SOBEL)
	{
		normal = CalculateNormalSobel(pos);
	}
	else if (CalculationMethod == METHOD_SOBEL_SCHARR)
	{
		normal = CalculateNormalSobelScharr(pos);
	}
	else // METHOD_CENTRAL_DIFFERENCE
	{
		normal = CalculateNormalCentralDifference(pos);
	}

	// Apply smoothing if enabled (simple box filter)
	if (EnableSmoothing > 0)
	{
		float3 smoothNormal = float3(0, 0, 0);
		float totalWeight = 0.0;
		int halfKernel = SmoothKernelSize / 2;

		for (int y = -halfKernel; y <= halfKernel; y++)
		{
			for (int x = -halfKernel; x <= halfKernel; x++)
			{
				int2 samplePos = pos + int2(x, y);
				if (samplePos.x >= 0 && samplePos.x < width && samplePos.y >= 0 && samplePos.y < height)
				{
					float3 sampleNormal;
					if (CalculationMethod == METHOD_SOBEL)
						sampleNormal = CalculateNormalSobel(samplePos);
					else if (CalculationMethod == METHOD_SOBEL_SCHARR)
						sampleNormal = CalculateNormalSobelScharr(samplePos);
					else
						sampleNormal = CalculateNormalCentralDifference(samplePos);

					smoothNormal += sampleNormal;
					totalWeight += 1.0;
				}
			}
		}

		if (totalWeight > 0.0)
		{
			normal = normalize(smoothNormal / totalWeight);
		}
	}

	// Convert normal from [-1, 1] to [0, 1] for storage
	float3 normalEncoded = normal * 0.5 + 0.5;

	NormalOutput[DispatchThreadId.xy] = float4(normalEncoded, 1.0);
}

//=============================================================================
// Normal Smoothing
//=============================================================================

Texture2D<float4> NormalInput;
int KernelSize;
float Sigma;

// Gaussian weight calculation
float GaussianWeight(float distance, float sigma)
{
	return exp(-(distance * distance) / (2.0 * sigma * sigma));
}

[numthreads(THREADGROUP_SIZE_X, THREADGROUP_SIZE_Y, THREADGROUP_SIZE_Z)]
void SmoothNormalsCS(
	uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint width, height;
	NormalOutput.GetDimensions(width, height);

	if (DispatchThreadId.x >= width || DispatchThreadId.y >= height)
	{
		return;
	}

	int2 pos = int2(DispatchThreadId.xy);
	float3 smoothNormal = float3(0, 0, 0);
	float totalWeight = 0.0;
	int halfKernel = KernelSize / 2;

	// Gaussian blur
	for (int y = -halfKernel; y <= halfKernel; y++)
	{
		for (int x = -halfKernel; x <= halfKernel; x++)
		{
			int2 samplePos = clamp(pos + int2(x, y), int2(0, 0), int2(width, height) - int2(1, 1));

			float4 normalSample = NormalInput[samplePos];
			// Decode normal from [0, 1] to [-1, 1]
			float3 normal = normalSample.xyz * 2.0 - 1.0;

			float distance = length(float2(x, y));
			float weight = GaussianWeight(distance, Sigma);

			smoothNormal += normal * weight;
			totalWeight += weight;
		}
	}

	if (totalWeight > 0.0)
	{
		smoothNormal = normalize(smoothNormal / totalWeight);
	}
	else
	{
		smoothNormal = float3(0, 0, 1);
	}

	// Encode normal back to [0, 1]
	float3 normalEncoded = smoothNormal * 0.5 + 0.5;
	NormalOutput[DispatchThreadId.xy] = float4(normalEncoded, 1.0);
}

//=============================================================================
// Edge Detection
//=============================================================================

RWTexture2D<float> EdgeOutput;
float Threshold;

[numthreads(THREADGROUP_SIZE_X, THREADGROUP_SIZE_Y, THREADGROUP_SIZE_Z)]
void DetectEdgesCS(
	uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint width, height;
	EdgeOutput.GetDimensions(width, height);

	if (DispatchThreadId.x >= width || DispatchThreadId.y >= height)
	{
		return;
	}

	int2 pos = int2(DispatchThreadId.xy);

	// Use Sobel operator for edge detection
	float tl = SampleHeight(pos + int2(-1, -1));
	float t  = SampleHeight(pos + int2( 0, -1));
	float tr = SampleHeight(pos + int2( 1, -1));
	float l  = SampleHeight(pos + int2(-1,  0));
	float r  = SampleHeight(pos + int2( 1,  0));
	float bl = SampleHeight(pos + int2(-1,  1));
	float b  = SampleHeight(pos + int2( 0,  1));
	float br = SampleHeight(pos + int2( 1,  1));

	float dx = (tr + 2.0 * r + br) - (tl + 2.0 * l + bl);
	float dy = (bl + 2.0 * b + br) - (tl + 2.0 * t + tr);

	dx *= HeightScale / 8.0;
	dy *= HeightScale / 8.0;

	// Edge magnitude
	float edgeMagnitude = sqrt(dx * dx + dy * dy);

	// Threshold
	float edge = (edgeMagnitude > Threshold) ? 1.0 : 0.0;

	EdgeOutput[DispatchThreadId.xy] = edge;
}
