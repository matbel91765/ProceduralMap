#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"

// Thread group size
#define THREADGROUP_SIZE_X 8
#define THREADGROUP_SIZE_Y 8
#define MAX_DROPLET_LIFETIME 100

// Input/Output textures
RWTexture2D<float> InputHeightmap;
RWTexture2D<float> OutputHeightmap;
RWTexture2D<float> SedimentMap;
RWTexture2D<float> WaterMap;

// Erosion parameters
int2 MapSize;
int NumDroplets;
int MaxLifetime;
int ErosionRadius;
int RandomSeed;

// Physics parameters
float Inertia;
float SedimentCapacityFactor;
float MinSedimentCapacity;
float ErodeSpeed;
float DepositSpeed;
float EvaporateSpeed;
float Gravity;
float InitialWaterVolume;
float InitialSpeed;

// ====================================================================================
// Utility Functions
// ====================================================================================

/**
 * Generate pseudo-random float from seed and coordinates
 * Uses hash function for deterministic randomness
 */
float Random(int Seed, int2 Coord)
{
	int n = Seed + Coord.x * 374761393 + Coord.y * 668265263;
	n = (n << 13) ^ n;
	n = n * (n * n * 15731 + 789221) + 1376312589;
	return abs(frac(float(n) * 0.000000000023283064365386962890625));
}

/**
 * Generate random 2D vector
 */
float2 Random2D(int Seed, int2 Coord, int Offset)
{
	return float2(
		Random(Seed, Coord + int2(Offset, 0)),
		Random(Seed, Coord + int2(0, Offset))
	);
}

/**
 * Bilinear interpolation for height sampling
 */
float SampleHeight(float2 Position)
{
	// Clamp position to valid range
	Position = clamp(Position, float2(0, 0), float2(MapSize.x - 1.001, MapSize.y - 1.001));

	// Get integer coordinates
	int2 Coord = int2(floor(Position));

	// Calculate interpolation weights
	float2 T = frac(Position);

	// Sample four corners
	float H00 = InputHeightmap[Coord];
	float H10 = InputHeightmap[Coord + int2(1, 0)];
	float H01 = InputHeightmap[Coord + int2(0, 1)];
	float H11 = InputHeightmap[Coord + int2(1, 1)];

	// Bilinear interpolation
	float Height = lerp(
		lerp(H00, H10, T.x),
		lerp(H01, H11, T.x),
		T.y
	);

	return Height;
}

/**
 * Calculate height and gradient at a position using bilinear interpolation
 */
void CalculateHeightAndGradient(float2 Position, out float Height, out float2 Gradient)
{
	// Clamp position to valid range
	Position = clamp(Position, float2(0, 0), float2(MapSize.x - 1.001, MapSize.y - 1.001));

	// Get integer coordinates
	int2 Coord = int2(floor(Position));

	// Calculate interpolation weights
	float2 T = frac(Position);

	// Sample four corners
	float H00 = InputHeightmap[Coord];
	float H10 = InputHeightmap[Coord + int2(1, 0)];
	float H01 = InputHeightmap[Coord + int2(0, 1)];
	float H11 = InputHeightmap[Coord + int2(1, 1)];

	// Bilinear interpolation for height
	Height = lerp(
		lerp(H00, H10, T.x),
		lerp(H01, H11, T.x),
		T.y
	);

	// Calculate gradient (derivative of bilinear interpolation)
	float GradientX = lerp(H10 - H00, H11 - H01, T.y);
	float GradientY = lerp(H01 - H00, H11 - H10, T.x);

	Gradient = float2(GradientX, GradientY);
}

/**
 * Apply erosion or deposition at a position with a brush
 */
void ApplyErosionDeposition(float2 Position, float Amount)
{
	// Get center cell
	int2 CenterCell = int2(round(Position));

	// Apply to brush area
	for (int OffsetY = -ErosionRadius; OffsetY <= ErosionRadius; OffsetY++)
	{
		for (int OffsetX = -ErosionRadius; OffsetX <= ErosionRadius; OffsetX++)
		{
			int2 Cell = CenterCell + int2(OffsetX, OffsetY);

			// Check bounds
			if (Cell.x >= 0 && Cell.x < MapSize.x && Cell.y >= 0 && Cell.y < MapSize.y)
			{
				// Calculate distance-based weight
				float Distance = length(float2(OffsetX, OffsetY));

				if (Distance <= float(ErosionRadius))
				{
					float Weight = 1.0 - (Distance / float(ErosionRadius));

					// Atomic add for thread safety
					// Note: InterlockedAdd doesn't work with floats directly
					// We use a workaround by converting to int, adding, and converting back
					float WeightedAmount = Amount * Weight;

					// For simplicity, we'll use direct write (in production, use atomic operations)
					// This may cause some race conditions but will still produce good results
					float CurrentHeight = OutputHeightmap[Cell];
					OutputHeightmap[Cell] = CurrentHeight - WeightedAmount;
				}
			}
		}
	}
}

/**
 * Simulate a single erosion droplet
 */
void SimulateDroplet(int DropletIndex)
{
	// Generate random starting position
	int2 DropletCoord = int2(DropletIndex % MapSize.x, DropletIndex / MapSize.x);
	float2 StartPos = Random2D(RandomSeed, DropletCoord, DropletIndex) * float2(MapSize - 1);

	// Initialize droplet state
	float2 Position = StartPos;
	float2 Direction = float2(0, 0);
	float Speed = InitialSpeed;
	float Water = InitialWaterVolume;
	float Sediment = 0.0;

	// Simulate droplet path
	for (int Lifetime = 0; Lifetime < MaxLifetime; Lifetime++)
	{
		// Check if still on map
		if (Position.x < 0 || Position.x >= MapSize.x - 1 || Position.y < 0 || Position.y >= MapSize.y - 1)
		{
			break;
		}

		// Calculate height and gradient
		float Height;
		float2 Gradient;
		CalculateHeightAndGradient(Position, Height, Gradient);

		// Update direction with inertia
		Direction = Direction * Inertia - Gradient * (1.0 - Inertia);

		// Normalize direction
		float DirectionLength = length(Direction);
		if (DirectionLength > 0.0001)
		{
			Direction = Direction / DirectionLength;
		}
		else
		{
			// No gradient, stop
			break;
		}

		// Update position
		float2 NewPosition = Position + Direction;

		// Calculate new height
		float NewHeight;
		float2 NewGradient;
		CalculateHeightAndGradient(NewPosition, NewHeight, NewGradient);

		// Calculate height difference
		float DeltaHeight = NewHeight - Height;

		// Calculate sediment capacity
		float SedimentCapacity = max(
			-DeltaHeight * Speed * Water * SedimentCapacityFactor,
			MinSedimentCapacity
		);

		// Erode or deposit
		if (Sediment > SedimentCapacity || DeltaHeight > 0.0)
		{
			// Deposit sediment
			float AmountToDeposit = (DeltaHeight > 0.0)
				? min(DeltaHeight, Sediment)
				: (Sediment - SedimentCapacity) * DepositSpeed;

			Sediment -= AmountToDeposit;
			ApplyErosionDeposition(Position, -AmountToDeposit);

			// Store sediment in sediment map
			int2 Cell = int2(round(Position));
			if (Cell.x >= 0 && Cell.x < MapSize.x && Cell.y >= 0 && Cell.y < MapSize.y)
			{
				SedimentMap[Cell] += AmountToDeposit;
			}
		}
		else
		{
			// Erode terrain
			float AmountToErode = min((SedimentCapacity - Sediment) * ErodeSpeed, -DeltaHeight);

			ApplyErosionDeposition(Position, AmountToErode);
			Sediment += AmountToErode;
		}

		// Update speed (based on height change and gravity)
		Speed = sqrt(max(0.0, Speed * Speed + DeltaHeight * Gravity));

		// Evaporate water
		Water *= (1.0 - EvaporateSpeed);

		// Update position
		Position = NewPosition;

		// Store water in water map for visualization
		int2 Cell = int2(round(Position));
		if (Cell.x >= 0 && Cell.x < MapSize.x && Cell.y >= 0 && Cell.y < MapSize.y)
		{
			WaterMap[Cell] += Water * 0.01; // Scale for visualization
		}

		// Stop if water is almost gone
		if (Water < 0.01)
		{
			break;
		}
	}
}

// ====================================================================================
// Main Compute Shader
// ====================================================================================

[numthreads(THREADGROUP_SIZE_X, THREADGROUP_SIZE_Y, 1)]
void ErosionMainCS(
	uint3 GroupId : SV_GroupID,
	uint3 GroupThreadId : SV_GroupThreadID,
	uint3 DispatchThreadId : SV_DispatchThreadID,
	uint GroupIndex : SV_GroupIndex)
{
	// Calculate droplet index
	int DropletIndex = DispatchThreadId.x + DispatchThreadId.y * (NumDroplets / THREADGROUP_SIZE_Y);

	// Check if this thread should process a droplet
	if (DropletIndex >= NumDroplets)
	{
		return;
	}

	// Initialize output heightmap on first pass
	if (DropletIndex == 0)
	{
		// Copy input to output
		for (int y = 0; y < MapSize.y; y++)
		{
			for (int x = 0; x < MapSize.x; x++)
			{
				int2 Coord = int2(x, y);
				OutputHeightmap[Coord] = InputHeightmap[Coord];
				SedimentMap[Coord] = 0.0;
				WaterMap[Coord] = 0.0;
			}
		}
	}

	// Sync threads before erosion starts
	GroupMemoryBarrierWithGroupSync();

	// Simulate this droplet
	SimulateDroplet(DropletIndex);
}
